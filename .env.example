# TemcoServers Environment Configuration
# ========================================
# Copy this to .env and fill in your values

# Existing MariaDB (temco-admin-mariadb container)
DB_PASSWORD=your_mariadb_root_password

# Contabo API
CONTABO_CLIENT_ID=INT-142497
CONTABO_CLIENT_SECRET=your_contabo_client_secret
CONTABO_API_USER=your_contabo_email
CONTABO_API_PASSWORD=your_contabo_api_password

# JWT Secret
JWT_SECRET=change-this-in-production

# AI API Keys (set when ready)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
